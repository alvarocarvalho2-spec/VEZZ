{
  "name": "vezz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local-demo",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode local-demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/security.test.mjs tests/database.test.mjs tests/edge.test.mjs tests/patient-registration.test.mjs tests/google-onboarding-cancel.test.mjs tests/queue.test.mjs",
    "test:logic": "node tests/logica.mjs && node tests/motion-timing.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:production": "npm run build && node scripts/verify-browser.mjs framework-production",
    "test:legacy:logic": "node tests/logica.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/cli": "^0.1.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "three": "0.186.1"
  }
}
